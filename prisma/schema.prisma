// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ETUDIANT
  PROFESSEUR
  ADMINISTRATEUR
}

enum Permission {
  READ
  WRITE
  MANAGE_MEMBERS
  MANAGE_PROXIES
  MANAGE_VMS
  ADMIN
}

model Users {
  UUID      String @id @default(uuid(7))
  firstName String
  lastName  String
  email     String @unique
  password  String

  groups         UserGroupPermissions[]
  ownedGroups    Groups[]               @relation("GroupOwner")
  forgotPassword forgotPassword[]       @relation("UserEmail")
  validateEmail  validateEmail[]        @relation("UserEmailValidation")
}

model validateEmail {
  UUID      String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  expireAt  DateTime

  userEmail String
  user      Users  @relation("UserEmailValidation", fields: [userEmail], references: [email])
}

model forgotPassword {
  UUID      String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  expireAt  DateTime

  userEmail String
  user      Users  @relation("UserEmail", fields: [userEmail], references: [email])
}

model Groups {
  UUID String @id @default(uuid(7))
  name String

  ownerId String
  owner   Users  @relation("GroupOwner", fields: [ownerId], references: [UUID])

  members                UserGroupPermissions[]
  GroupCode              GroupCode?
  defaultRolePermissions DefaultRolePermission[]
}

model UserGroupPermissions {
  UUID     String   @id @default(uuid(7))
  joinedAt DateTime @default(now())

  userId String
  user   Users  @relation(fields: [userId], references: [UUID])

  groupId String
  group   Groups @relation(fields: [groupId], references: [UUID])

  permissions GroupPermission[]
  role        Role              @default(ETUDIANT)

  @@unique([userId, groupId]) // un user = une entrée par groupe
}

model GroupPermission {
  UUID       String     @id @default(uuid(7))
  permission Permission

  membershipId String
  membership   UserGroupPermissions @relation(fields: [membershipId], references: [UUID])

  @@unique([membershipId, permission]) // pas de doublon de permission
}

model GroupCode {
  UUID    String @id @default(uuid(7))
  code    String @unique // le code du groupe
  group   Groups @relation(fields: [groupId], references: [UUID])
  groupId String @unique // un code = un groupe
}

model DefaultRolePermission {
  UUID       String     @id @default(uuid(7))
  role       Role
  permission Permission

  groupId String
  group   Groups @relation(fields: [groupId], references: [UUID])

  @@unique([role, permission]) // pas de doublon de permission pour un rôle
}
