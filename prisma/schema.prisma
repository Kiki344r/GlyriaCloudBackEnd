generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Permission {
  VMS
  MODULES
  MANAGE_VMS
  MANAGE_MODULES
  MANAGE_MEMBERS
  MANAGE_CODES
  MANAGE_ROLES
  MANAGE_SETTINGS
  ADMINISTRATOR
}

enum VmType {
  LYCEE
  LOCAL
}

enum ModuleItemType {
  TP
  COURS
  EXERCICE
}

// ─── Modèles existants ────────────────────────────────────────────────────────

model Users {
  UUID      String @id @default(uuid(7))
  firstName String
  lastName  String
  email     String @unique
  password  String

  groups      UserGroupPermissions[]
  ownedGroups Groups[]               @relation("GroupOwner")

  emailValidations EmailValidation[]
  passwordResets   ForgotPassword[]

  vms       GroupVm[]
  linkedVms ModuleVmLink[]
}

model EmailValidation {
  UUID      String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  expireAt  DateTime

  userId String
  user   Users  @relation(fields: [userId], references: [UUID], onDelete: Cascade)
}

model ForgotPassword {
  UUID      String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  expireAt  DateTime

  userId String
  user   Users  @relation(fields: [userId], references: [UUID], onDelete: Cascade)
}

model Groups {
  UUID String @id @default(uuid(7))
  name String

  ownerId String
  owner   Users  @relation("GroupOwner", fields: [ownerId], references: [UUID])

  members UserGroupPermissions[]
  codes   GroupCode[]
  roles   GroupRoles[]

  defaultRoleId String?
  defaultRole   GroupRoles? @relation("DefaultRole", fields: [defaultRoleId], references: [UUID])

  modules GroupModule[]
  vms     GroupVm[]
}

model UserGroupPermissions {
  UUID     String   @id @default(uuid(7))
  joinedAt DateTime @default(now())

  userId String
  user   Users  @relation(fields: [userId], references: [UUID], onDelete: Cascade)

  groupId String
  group   Groups @relation(fields: [groupId], references: [UUID], onDelete: Cascade)

  roleId String
  role   GroupRoles @relation(fields: [roleId], references: [UUID])

  @@unique([userId, groupId])
}

model GroupRoles {
  UUID String @id @default(uuid(7))
  name String

  groupId String
  group   Groups @relation(fields: [groupId], references: [UUID], onDelete: Cascade)

  permissions GroupsRolesPermissions[]
  members     UserGroupPermissions[]

  defaultFor Groups[] @relation("DefaultRole")
}

model GroupsRolesPermissions {
  UUID String @id @default(uuid(7))

  roleId String
  role   GroupRoles @relation(fields: [roleId], references: [UUID], onDelete: Cascade)

  permission Permission

  @@unique([roleId, permission])
}

model GroupCode {
  UUID String @id @default(uuid(7))

  code    String @unique
  groupId String
  group   Groups @relation(fields: [groupId], references: [UUID], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([groupId, code])
}

// ─── Nouveaux modèles ─────────────────────────────────────────────────────────

model GroupModule {
  UUID        String  @id @default(uuid(7))
  name        String
  description String? @db.Text
  requiresVm  Boolean @default(false)

  groupId String
  group   Groups @relation(fields: [groupId], references: [UUID], onDelete: Cascade)

  items   GroupModuleItem[]
  vmLinks ModuleVmLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GroupModuleItem {
  UUID    String         @id @default(uuid(7))
  title   String
  type    ModuleItemType
  content String         @db.LongText
  order   Int            @default(0)

  moduleId String
  module   GroupModule @relation(fields: [moduleId], references: [UUID], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GroupVm {
  UUID String @id @default(uuid(7))
  name String
  type VmType

  // Champs LYCEE
  nodeId String?
  node   PVENodes? @relation(fields: [nodeId], references: [UUID], onDelete: Cascade)
  vmid   Int?
  os     String?

  // Champs LOCAL
  ip      String?
  sshPort Int?
  rdpPort Int?

  groupId String
  group   Groups @relation(fields: [groupId], references: [UUID], onDelete: Cascade)

  userId String
  user   Users  @relation(fields: [userId], references: [UUID], onDelete: Cascade)

  proxies VmProxy[]
  vmLinks ModuleVmLink[]

  createdAt DateTime @default(now())
}

model VmProxy {
  UUID         String  @id @default(uuid(7))
  internalPort Int
  exposedIp    String
  exposedPort  Int
  description  String?

  vmId String
  vm   GroupVm @relation(fields: [vmId], references: [UUID], onDelete: Cascade)

  usedPort UsedPort?

  createdAt DateTime @default(now())

  @@unique([vmId, internalPort])
}

model ModuleVmLink {
  UUID String @id @default(uuid(7))

  moduleId String
  module   GroupModule @relation(fields: [moduleId], references: [UUID], onDelete: Cascade)

  vmId String
  vm   GroupVm @relation(fields: [vmId], references: [UUID], onDelete: Cascade)

  userId String
  user   Users  @relation(fields: [userId], references: [UUID], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([moduleId, userId])
}

model PortRange {
  UUID     String  @id @default(uuid(7))
  fromPort Int
  toPort   Int
  label    String?
  ip       String

  createdAt DateTime @default(now())

  @@unique([ip, fromPort])
}

model UsedPort {
  UUID String @id @default(uuid(7))
  port Int
  ip   String

  vmProxyId String  @unique
  vmProxy   VmProxy @relation(fields: [vmProxyId], references: [UUID], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([ip, port])
}

model PVENodes {
  UUID String @id @default(uuid(7))
  name String

  maxVMs Int
  vms    GroupVm[]

  templateId Int

  createdAt DateTime @default(now())
}
